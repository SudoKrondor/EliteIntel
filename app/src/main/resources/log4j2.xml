<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Properties>
        <Property name="logPattern">%d{HH:mm:ss} %-6p→ %c{1}.%M(%F:%L) - %m%n</Property>
        <Property name="logPath">logs/</Property>
        <Property name="rollingFileName">elite-intel</Property>
    </Properties>

    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="${logPattern}"/>
        </Console>
        <!-- %i is not decoration: the size policy below rolls at 1MB, and a
             pattern with only a date in it gives every roll on the same day the
             same filename, so each one overwrites the last and a long session
             keeps just the most recent megabyte of history. The counter is what
             makes the 7 kept files actually be 7 files. -->
        <RollingFile name="rollingFile" fileName="${logPath}/${rollingFileName}.log"
                     filePattern="${logPath}/${rollingFileName}_%d{yyyy-MM-dd}_%i.log" immediateFlush="true">
            <PatternLayout pattern="${logPattern}"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="1MB"/>
            </Policies>
            <DefaultRolloverStrategy max="7"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- Suppress third-party logs -->
        <Logger name="io.grpc" level="off"/>
        <Logger name="io.grpc.netty" level="off"/>
        <Logger name="io.grpc.netty.shaded" level="off"/>
        <Logger name="io.netty" level="off"/>

        <Logger name="org.apache" level="off"/>
        <Logger name="org.sqlite" level="off"/>
        <Logger name="org.sqlite.core" level="off"/>
        <Logger name="org.sqlite.jdbc" level="off"/>
        <Logger name="org.jdbi.v3.core" level="off"/>
        <Logger name="org.jdbi.v3" level="off"/>
        <Logger name="com.zaxxer" level="off"/>
        <Logger name="org.java_websocket" level="off"/>


        <!-- Specific logger levels -->
        <Logger name="elite.intel" level="error"/>
        <!-- Also more specific than elite.intel, and deliberately louder than it.
             The HUD overlay is a separate native process: this logger carries its
             mode line and everything the child writes to stderr - which SteamVR
             interface it attached to, which EVROverlayError a frame was refused
             with, when a texture was reallocated. At error level none of that
             reached the file, so a commander reporting "the VR HUD flickers" could
             only ever send us a log with nothing about the overlay in it. Every
             line here is edge-triggered, never per-frame, so the cost is a handful
             of lines a session. -->
        <Logger name="elite.intel.ui.overlay" level="info"/>
        <!-- Also louder than elite.intel. The startup configuration check logs ONLY when it has
             something to complain about - no LLM model chosen, an unreadable journal or bindings
             directory - so a healthy install writes nothing here at all. That makes it free, and
             it answers the first question every report raises: what was this commander actually
             configured with? -->
        <Logger name="elite.intel.setup" level="info"/>
        <!-- Also louder than elite.intel. Four lines a session: the SDL3 init, and one per
             controller as it appears or goes away, carrying the device name, axis and button
             counts. "Push-to-talk does nothing" and "my HOTAS stopped working" are both answered
             by whether the device was ever seen, and nothing else in the bundle records that. -->
        <Logger name="elite.intel.devices" level="info"/>
        <!-- Also louder than elite.intel, for the same reason as the overlay above. Memory
             consolidation used to announce its failures out loud, which told the commander
             about housekeeping they can do nothing about (the batch is retried, and falls
             back to a local summary). It is logged instead - but at the parent's error level
             the warn line would have been discarded, leaving the failure with nowhere to go
             at all. Edge-triggered: one line per failed batch, not per record. -->
        <Logger name="elite.intel.ai.brain.vega.memory" level="debug"/>
        <Logger name="elite.intel.gameapi.JournalParser" level="error"/>
        <!-- warn, on purpose: a file caught mid-write is retried rather than dropped, and seeing how
             often that happens is the only way to tell a slow disk from a stuck market. -->
        <Logger name="elite.intel.gameapi.AuxiliaryFilesMonitor" level="warn"/>
        <Logger name="elite.intel.gameapi.journal.subscribers" level="error"/>
        <!-- info, and louder than elite.intel, or this logger writes nothing at all. Exobiology
             payouts are fixed game constants that the journal states only at the moment of sale, so
             everything spoken before then comes from a table curated by hand - and a hand-curated
             table drifts silently. The 2026-08-30 audit found 15 wrong rows in 117 (three of them
             the constant 0xFFFFFF, a 24-bit clamp) and nothing in the app had ever noticed. These
             lines are how the next drift arrives: in a commander's diagnostics bundle, already
             carrying the corrected figure. Edge-triggered on a SALE - a few times a session at
             most, one summary line plus one per disagreeing row. -->
        <Logger name="elite.intel.gameapi.data.BioFormsValueAudit" level="info"/>
        <Logger name="elite.intel.gameapi.journal.subscribers.LocationTrackingSubscriber" level="error"/>
        <Logger name="elite.intel.gameapi.journal.subscribers.SilentPersistenceSubscriber" level="error"/>
        <Logger name="elite.intel.gameapi.journal.EventRegistry" level="error"/>
        <Logger name="elite.intel.gameapi.search.edsm.EdsmApiClient" level="error"/>
        <Logger name="elite.intel.search.spansh.client" level="error"/>
        <Logger name="elite.intel.util.NavigationUtils" level="error"/>
        <Logger name="elite.intel.ai.hands" level="debug"/>
        <Logger name="elite.intel.ai.brain.inference" level="error"/>
        <!-- info, on purpose, and louder than elite.intel. A push-to-talk press that produces nothing
             leaves no trace anywhere else: the transcript is dropped inside transcribeAndDispatch without
             reaching the UI or an event, so at error level a commander reporting "it missed what I said"
             could only ever send a log with nothing about the capture in it. Every line here is
             edge-triggered - one per utterance, never per audio frame - so a session costs a few dozen. -->
        <Logger name="elite.intel.ai.ears" level="info"/>
        <!-- warn, not error: every warn under here is a FAILURE and none of them fire per
             utterance - Kokoro playback errors, a voice list that could not be enumerated, a
             request that could not be queued. At error level "the voice stopped working"
             arrived with nothing under it, because the thing that broke logged a warn. -->
        <Logger name="elite.intel.ai.mouth" level="warn"/>
        <Logger name="elite.intel.ai.brain" level="error"/>
        <!-- The companion pipeline, louder than the brain it sits in, and the single most
             valuable thing in a bundle: "the LLM round failed", "the response had defect X,
             retrying via Y", "the model asked for more tool calls than the turn allows". A
             commander reporting "it ignored me" or "it did the wrong thing" is reporting one
             of those lines, and at error level none of them were written down. Edge-triggered
             on a failed or salvaged turn, never per turn. -->
        <Logger name="elite.intel.ai.brain.vega" level="warn"/>
        <Logger name="elite.intel.search" level="debug"/>
        <Logger name="elite.intel.db" level="debug"/>
        <Logger name="elite.intel.db.managers.SubSystemsManager" level="error"/>
        <Logger name="elite.intel.ai.brain.handlers" level="debug"/>
        <Logger name="elite.intel.ws" level="error"/>
        <!-- warn, on purpose: the two lines under here are "that panel's key is unbound" and
             "the panel did not open, retrying", which is the visible half of a binding problem -
             the commander sees a command do nothing. See the binding-conflict reports. -->
        <Logger name="elite.intel.session" level="warn"/>

        <!-- Root logger -->
        <Root level="debug">
            <AppenderRef ref="rollingFile"/>
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
