// Windows resources for the HUD overlay.
//
// The overlay window is no longer a tool window (see platform_win32.c), so it
// now has a taskbar button and an alt-tab entry, both of which show an icon.
// Without one Windows draws its generic placeholder, so the mark the rest of
// the app uses is embedded here: ai.ico is app/src/main/resources/images/ai.png
// converted to a multi-size .ico, since Win32 cannot load a PNG as a window
// icon and the taskbar, alt-tab and the window frame all want different sizes.
//
// Regenerate with:
//   magick app/src/main/resources/images/ai.png -background none \
//          -define icon:auto-resize=256,128,64,48,32,24,16 overlay/res/ai.ico

#include "resource.h"

IDI_APPICON ICON "ai.ico"
